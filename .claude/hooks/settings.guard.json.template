{
  "_comment": "가드 훅 활성화 템플릿 — 내용을 .claude/settings.local.json에 병합하세요. bypassPermissions 모드 사용자는 필수 (allowlist가 무효이므로 PreToolUse 훅이 유일한 기계 방어선 — 공식 보증: hook deny는 bypass 모드도 뚫지 못함). config-guard는 세션 중 hooks 설정 변조를 무효화하는 메타 방어.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pretool-guard.sh\""
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/config-guard.sh\""
          }
        ]
      }
    ]
  }
}
