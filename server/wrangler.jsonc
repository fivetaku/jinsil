{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "jinsil",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    // database_id는 배포 단계(사용자 승인)에서 `wrangler d1 create` 결과로 채운다. 로컬 개발은 이 값과 무관.
    { "binding": "DB", "database_name": "jinsil", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "./migrations" }
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": "",
    "GOOGLE_AUTH_URL": "https://accounts.google.com/o/oauth2/v2/auth",
    "GOOGLE_TOKEN_URL": "https://oauth2.googleapis.com/token",
    "MIN_ACCOUNTS": "5",
    "PROBATION_HOURS": "24",
    "DEV_IDP": "0"
  },
  // GOOGLE_CLIENT_SECRET, SESSION_PEPPER 는 wrangler secret (배포 시 사용자 승인). 로컬은 .dev.vars.
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": true }
}
