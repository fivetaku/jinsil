{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "jinsil",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  // 정적 파일(OG 이미지·파비콘). 경로가 일치하면 Worker보다 먼저 응답한다.
  "assets": { "directory": "./public" },
  "d1_databases": [
    // 운영 D1 (2026-09-23 생성). 로컬 개발은 --local 저장소를 쓰므로 이 값과 무관.
    { "binding": "DB", "database_name": "jinsil", "database_id": "f2fa342a-035e-4f91-a4e4-a0754d247b6c", "migrations_dir": "./migrations" }
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": "539249206986-52tn1fabd4hkb2dvd7pbe68q3d9rsiop.apps.googleusercontent.com",
    "GOOGLE_AUTH_URL": "https://accounts.google.com/o/oauth2/v2/auth",
    "GOOGLE_TOKEN_URL": "https://oauth2.googleapis.com/token",
    "MIN_ACCOUNTS": "3",
    "PROBATION_HOURS": "0",
    "DEV_IDP": "0"
  },
  // GOOGLE_CLIENT_SECRET 은 wrangler secret. 로컬은 .dev.vars(모의 IdP).
  "routes": [{ "pattern": "jinsil.axwith.com", "custom_domain": true }],
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": true }
}
